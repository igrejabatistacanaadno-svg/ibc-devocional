# ================================================================
# IBC Devocional — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA faça commit do arquivo .env no git!
# ================================================================

# ─── Supabase ────────────────────────────────────────────────────
# Acesse: https://app.supabase.com → Seu Projeto → Settings → API
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ─── VAPID Keys (Push Notifications) ────────────────────────────
# Gere em: https://vapidkeys.com ou via comando:
# npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=BNxxxxxxxxxxxxxxxxxxxxxxx
# (a chave privada fica SOMENTE no Supabase Edge Function secrets)

# ─── Admin (desenvolvimento local) ───────────────────────────────
# Usado como fallback quando Supabase não está configurado
# Em produção, use a tabela admin_users no Supabase
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=senha_dev_apenas

# ─── App Config ──────────────────────────────────────────────────
VITE_APP_NAME="IBC Devocional"
VITE_CHURCH_NAME="Igreja Batista Canaã"
VITE_CHURCH_CODE="@igrejabatistaibc"
